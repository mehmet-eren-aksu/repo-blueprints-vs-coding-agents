{
  "id": "cfg-discovered",
  "feature": "config.discovery",
  "desc": "pedantix.toml next to the file is used",
  "args": [
    "{tmp}/f.nix"
  ],
  "dirs": [
    ".git"
  ],
  "files": {
    "pedantix.toml": "formatter = \"off\"\n[attrs]\nlast = [\"a\"]\n",
    "f.nix": "{ a = 1; c = 2; b = 3; }\n"
  },
  "watch_files": [
    "f.nix"
  ]
}
