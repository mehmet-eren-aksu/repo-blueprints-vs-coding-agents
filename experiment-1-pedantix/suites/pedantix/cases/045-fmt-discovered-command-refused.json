{
  "id": "fmt-discovered-command-refused",
  "feature": "formatter.safety",
  "desc": "formatter-command from a discovered config is not executed",
  "args": [
    "{tmp}/f.nix"
  ],
  "files": {
    "pedantix.toml": "formatter-command = [\"cat\"]\n",
    "f.nix": "{ b = 1; a = 2; }\n"
  },
  "watch_files": [
    "f.nix"
  ],
  "stderr_contains": [
    "--allow-formatter-command"
  ]
}
