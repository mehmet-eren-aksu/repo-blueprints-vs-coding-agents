{
  "id": "spacing-mode-all",
  "feature": "spacing",
  "desc": "top-level-blank-lines-mode = all",
  "args": [
    "--config-toml",
    "formatter = \"off\"\ntop-level-blank-lines = 1\ntop-level-blank-lines-mode = \"all\""
  ],
  "stdin": "{\n  b = 2;\n\n\n  a = 1;\n  c = { y = 2; x = 1; };\n}\n",
  "idempotent": true
}
