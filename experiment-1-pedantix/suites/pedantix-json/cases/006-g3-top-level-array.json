{
  "id": "g3-top-level-array",
  "feature": "g3.arrays",
  "desc": "A top-level array of scalars is left as is",
  "args": [
    "--config-toml",
    "formatter = \"off\"",
    "--stdin-filepath",
    "{tmp}/data.json"
  ],
  "stdin": "[3, 1, 2]\n",
  "compare": [
    "exit",
    "json:stdout"
  ]
}
